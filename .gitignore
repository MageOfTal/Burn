# ===========================================================
# Root .gitignore for Burn Royale
# Repo root: C:\The Great Project\
# Game files: ProjectFiles/
# Engine patches: Engine/godot-source/modules/jolt_physics/
# ===========================================================

# --- Only track ProjectFiles/ and Engine patches ---
# Ignore everything else at root level
Tools/
.claude/
plan.md
news-trader/
assets/
debug.log
logger.txt

# --- ProjectFiles ignores (same as before) ---
ProjectFiles/.godot/
ProjectFiles/export/
ProjectFiles/*.exe
ProjectFiles/*.pck

# --- Webview addons (unused, contain large redistributables) ---
ProjectFiles/addons/godot_cef/
ProjectFiles/addons/godot_wry/

# --- Generated terrain bake caches (regenerated at runtime if missing) ---
ProjectFiles/terrain/*.bin

# --- Engine: ignore everything, then whitelist patched files + binaries ---
# Must un-ignore each directory level for negation to work.
Engine/**
!Engine/Godot_v4.6-stable_win64.exe
!Engine/Godot_v4.6-stable_win64_console.exe
!Engine/godot-source/
Engine/godot-source/**
!Engine/godot-source/build.bat
!Engine/godot-source/modules/
Engine/godot-source/modules/**
!Engine/godot-source/modules/jolt_physics/
Engine/godot-source/modules/jolt_physics/**
