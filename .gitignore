# ===========================================================
# Root .gitignore for Burn Royale
# Repo root: C:\The Great Project\
# Game files: ProjectFiles/
# Engine patches: Engine/godot-source/modules/jolt_physics/
# ===========================================================

# --- Only track ProjectFiles/ and Engine patches ---
# Ignore everything else at root level
Tools/
.claude/
plan.md

# --- ProjectFiles ignores (same as before) ---
ProjectFiles/.godot/
ProjectFiles/export/
ProjectFiles/*.exe
ProjectFiles/*.pck

# --- Webview addons (unused, contain large redistributables) ---
ProjectFiles/addons/godot_cef/
ProjectFiles/addons/godot_wry/

# --- Generated terrain bake caches (regenerated at runtime if missing) ---
ProjectFiles/terrain/*.bin

# --- Engine: ignore everything, then whitelist patched files + binaries ---
# Must un-ignore each directory level for negation to work.
Engine/**
# Engine binaries are NOT committed -- they are distributed via GitHub Releases
# (see SETUP.md). Build them with Engine/build.bat or download a release.
!Engine/godot-source/
Engine/godot-source/**
!Engine/godot-source/build.bat
!Engine/godot-source/modules/
Engine/godot-source/modules/**
!Engine/godot-source/modules/jolt_physics/
Engine/godot-source/modules/jolt_physics/**
!Engine/godot-source/modules/jolt_physics/jolt_physics_server_3d.h
!Engine/godot-source/modules/jolt_physics/jolt_physics_server_3d.cpp
!Engine/godot-source/modules/jolt_physics/jolt_project_settings.h
!Engine/godot-source/modules/jolt_physics/jolt_project_settings.cpp
!Engine/godot-source/modules/jolt_physics/objects/
Engine/godot-source/modules/jolt_physics/objects/**
!Engine/godot-source/modules/jolt_physics/objects/jolt_body_3d.h
!Engine/godot-source/modules/jolt_physics/spaces/
Engine/godot-source/modules/jolt_physics/spaces/**
!Engine/godot-source/modules/jolt_physics/spaces/jolt_contact_listener_3d.h
!Engine/godot-source/modules/jolt_physics/spaces/jolt_contact_listener_3d.cpp
!Engine/godot-source/modules/jolt_physics/spaces/jolt_physics_direct_space_state_3d.h
!Engine/godot-source/modules/jolt_physics/spaces/jolt_physics_direct_space_state_3d.cpp
!Engine/godot-source/modules/jolt_physics/spaces/jolt_space_3d.cpp
!Engine/godot-source/modules/godot_physics_3d/
Engine/godot-source/modules/godot_physics_3d/**
!Engine/godot-source/modules/godot_physics_3d/godot_space_3d.h
!Engine/godot-source/modules/godot_physics_3d/godot_space_3d.cpp
!Engine/godot-source/servers/
Engine/godot-source/servers/**
!Engine/godot-source/servers/physics_3d/
Engine/godot-source/servers/physics_3d/**
!Engine/godot-source/servers/physics_3d/physics_server_3d.h
!Engine/godot-source/servers/physics_3d/physics_server_3d.cpp
!Engine/godot-source/servers/physics_3d/physics_server_3d_extension.h
!Engine/godot-source/servers/physics_3d/physics_server_3d_dummy.h

# --- Custom engine modules (fully owned by this repo, track everything) ---
!Engine/godot-source/modules/block_mesh/
!Engine/godot-source/modules/block_mesh/**
Engine/godot-source/modules/block_mesh/__pycache__/
!Engine/godot-source/modules/terrain_fill/
!Engine/godot-source/modules/terrain_fill/**
Engine/godot-source/modules/terrain_fill/__pycache__/

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.vscode/
*.swp
*.swo

# --- Editor / build temp files ---
~*.dll
*.TMP
*~RF*

# --- Windows NUL device artifact ---
nul
